# Copy to .env (or export these) — NEVER commit a real token.
# Hosted Otari.ai gateway (default base https://api.otari.ai):
OTARI_AI_TOKEN=
# Model routed through Otari, format provider:model or vendor/model:
# Default is mistralai/mistral-small-latest — verified live on Otari
# 9 Nov 2026 (openai:gpt-4o-mini is NOT offered on Otari: gateway 424
# provider_not_configured, no OpenAI provider in the catalogue).
OTARI_MODEL=mistralai/mistral-small-latest
# Provider: auto (Otari if a token is set, else mock) | mock | otari
OTARI_PROVIDER=auto
# Self-hosted gateway alternative (leave blank for hosted):
# GATEWAY_API_BASE=http://localhost:8000
# GATEWAY_API_KEY=
# Notes folder (default: notes/):
# NOTES_ROOT=notes
